{
  "name": "aurum-ops",
  "version": "1.0.0",
  "description": "Aurum Ops — internal agile board & client pipeline command center (black/gold glass + neumorphic)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "sync:excalidraw": "node scripts/sync-excalidraw.mjs",
    "test": "node --test tests/domain.test.js && node tests/spa.smoke.test.js",
    "audit:prod": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  }
}
